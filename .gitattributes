# Auto detect text files and perform LF normalization
* text=auto

# JavaScript
*.js text eol=lf
*.mjs text eol=lf

# HTML
*.html text eol=lf

# CSS
*.css text eol=lf

# JSON
*.json text eol=lf

# Markdown
*.md text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary
*.ico binary
*.png binary
*.jpg binary
*.exe binary
*.dll binary
